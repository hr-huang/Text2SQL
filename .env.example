# Application
APP_NAME=Enterprise Text2SQL
APP_ENV=dev

# Active LLM preset
LLM_PRESET=deepseek_v4_flash

# OpenAI-compatible LLM endpoint for the active preset.
# Keep real keys in .env only; never commit secrets.
DEEPSEEK_V4_FLASH_KEY=your_api_key_here
DEEPSEEK_V4_FLASH_URL=https://api.example.com/v1
DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash

# Optional reasoning config for models that support it.
LLM_THINKING=disabled
LLM_REASONING_EFFORT=medium

# Optional HTTP proxy for LLM API calls (e.g. some networks need Clash for DeepSeek).
# Leave empty to connect directly. Examples: http://127.0.0.1:7897
LLM_PROXY=

# ── SiliconFlow（统一提供 embedding + rerank）──
SILICONFLOW_API_KEY=sk-your_siliconflow_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
SILICONFLOW_TIMEOUT=60

# Schema retrieval.
# 启用混合检索（向量 + BM25）→ RRF 融合 → Rerank
# 取 0 关闭，等同于历史纯向量行为
RAG_HYBRID_ENABLED=1
# 取值 1 / 0；开启后未配置 SiliconFlow key 时自动降级为纯向量
RAG_RERANK_ENABLED=1
# If table count is <= this threshold, the service returns full schema.
RAG_THRESHOLD=15
